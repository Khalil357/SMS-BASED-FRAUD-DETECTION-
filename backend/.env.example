# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Email (SMTP) ----
# Which EmailService bean is active: "smtp" (default) or "resend".
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
# 16-character Gmail App Password (enable 2-Step Verification first).
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# For Gmail SMTP the "from" address must match SMTP_USERNAME.
EMAIL_FROM=you@gmail.com
EMAIL_SUPPORT=support@smsfraud.com

# ---- Resend (only used when EMAIL_PROVIDER=resend) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ---- JWT ----
# HS256 secret must be at least 32 bytes.
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes!

# ---- PostgreSQL (docker-compose service) ----
POSTGRES_DB=sms_fraud
POSTGRES_USER=sms_app
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Redis is reachable only inside the Docker network, but still requires auth.
REDIS_PASSWORD=replace-with-a-long-random-password

# ---- App datasource (matches the Postgres values above) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/sms_fraud
SPRING_DATASOURCE_USERNAME=sms_app
SPRING_DATASOURCE_PASSWORD=replace-with-a-long-random-database-password

# ---- Public deployment URLs ----
# HTTP port published by the Nginx reverse proxy on the EC2 host.
HTTP_PORT=80
HTTPS_PORT=443
# Use nginx-http.conf only while obtaining the initial certificate, then switch
# to nginx.conf and recreate the Nginx container.
NGINX_CONFIG=nginx-http.conf
# Public backend address and the frontend origin allowed by CORS. Do not add a
# trailing slash. Use HTTPS URLs after putting a load balancer/proxy in front.
APP_URL=http://YOUR_EC2_PUBLIC_IP
APP_WEB_URL=https://your-frontend.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# Keep API documentation off on public deployments unless temporarily needed.
SWAGGER_ENABLED=false

# Optional first administrator. Leave disabled after the account is created.
ADMIN_SEED_ENABLED=false
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+255700000000
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ---- ML fraud-classification service ----
# The gateway is HTTPS only; port 3232 must not be used.
# Request the API key from Barthez. Never commit the real key.
ML_SERVICE_URL=https://13.53.200.176
ML_SERVICE_API_KEY=replace-with-key-from-barthez
# Temporary workaround only; restore to false when the gateway certificate is fixed.
ML_SERVICE_INSECURE_TLS=false

# ---- ML fraud-classification service ----
# The gateway is HTTPS only; port 3232 must not be used.
# Request the API key from Barthez. Never commit the real key.
ML_SERVICE_URL=https://13.53.200.176
ML_SERVICE_API_KEY=replace-with-key-from-barthez

# ---- Meseji (SMS) — https://www.meseji.co.tz ----
# Generate a key in the dashboard under Developer Settings / API Keys.
MESEJI_API_KEY=your_meseji_api_key
# Approved sender ID (default "MESEJI" is pre-approved; use your own once approved).
MESEJI_SENDER_ID=MESEJI
MESEJI_BASE_URL=https://meseji.co.tz/api/v1
