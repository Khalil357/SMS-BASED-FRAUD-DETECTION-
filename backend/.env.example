# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Resend (transactional email / OTP) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Dev sender (no domain needed, delivers only to your Resend account email):
EMAIL_FROM=onboarding@resend.dev
# Production: use a domain verified in your Resend dashboard, e.g. noreply@yourdomain.com
EMAIL_SUPPORT=support@smsfraud.com

# ---- JWT ----
# HS256 secret must be at least 32 bytes.
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes!

# ---- PostgreSQL (docker-compose service) ----
POSTGRES_DB=sms_fraud
POSTGRES_USER=sms_app
POSTGRES_PASSWORD=sms_pass

# ---- App datasource (matches the Postgres values above) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/sms_fraud
SPRING_DATASOURCE_USERNAME=sms_app
SPRING_DATASOURCE_PASSWORD=sms_pass

# ---- SMS provider ----
# Which SMS gateway is active: "meseji" (default) or "twilio".
SMS_PROVIDER=meseji

# ---- Meseji (SMS) — https://www.meseji.co.tz ----
# Generate a key in the dashboard under Developer Settings / API Keys.
MESEJI_API_KEY=zs_a50658566b91e1befa8af179f5fe6cf189ef8fe67672f09c
# Approved sender ID (default "MESEJI" is pre-approved; use your own once approved).
MESEJI_SENDER_ID=MESEJI
MESEJI_BASE_URL=https://meseji.co.tz/api/v1

# ---- Twilio (SMS) — optional; only used when SMS_PROVIDER=twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
